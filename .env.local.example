# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Service Account (dipakai untuk upload ke Drive & OCR Vision API)
# Buat service account di Google Cloud Console, aktifkan "Google Drive API" dan
# "Cloud Vision API", lalu share folder Drive tujuan ke email service account ini.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your-shared-drive-folder-id

# Telegram Bot (notifikasi otomatis saat pengajuan disetujui)
# Buat bot lewat @BotFather di Telegram, salin token yang diberikan.
TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
